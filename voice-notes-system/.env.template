# Voice Notes System Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# MCP Server Configuration (Voice Notes now acts as MCP server for Claude Desktop)
# These are optional - only needed if connecting to external MCP servers
MCP_SERVER_URL=your_mcp_server_url_here
MCP_API_KEY=your_mcp_api_key_here

# Voice Notes MCP Server Settings
VOICE_NOTES_MCP_MODE=server
VOICE_NOTES_MCP_HOST=localhost
VOICE_NOTES_MCP_PORT=8000

# Optional: Custom paths
VOICE_NOTES_OUTPUT_DIR=/path/to/your/notes/directory
VOICE_NOTES_CONFIG_DIR=/path/to/your/config/directory

# Optional: Logging level override
LOG_LEVEL=INFO